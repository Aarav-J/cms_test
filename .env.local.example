# ─────────────────────────────────────────────────────────────
# Copy this file to .env.local and fill in your values.
# Never commit .env.local to git.
# ─────────────────────────────────────────────────────────────

# ── GitHub ───────────────────────────────────────────────────
# Personal access token with repo → Contents read+write scope
GITHUB_TOKEN=ghp_YOUR_TOKEN_HERE

# Owner (your GitHub username or org)
GITHUB_OWNER=your-github-username

# Repo name
GITHUB_REPO=your-repo-name

# Branch to push to (default: main)
GITHUB_BRANCH=main

# Path inside the repo where the content file lives
GITHUB_CONTENT_PATH=content/site-data.json

# ── CMS login ────────────────────────────────────────────────
# Anyone with this password can publish. Change it.
CMS_PASSWORD=changeme
